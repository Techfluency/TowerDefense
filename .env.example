# ---------------------------------------------------------------
# Tower Defense Game -- Environment Variables
# ---------------------------------------------------------------
# Copy this file to .env and adjust values for your environment.
# All variables prefixed with VITE_ are exposed to client-side code
# via import.meta.env. Do NOT put secrets here -- this is a
# client-side-only game and all VITE_ values are bundled into the
# JavaScript output.
# ---------------------------------------------------------------

# Game version displayed in the HUD and main menu.
VITE_GAME_VERSION=0.1.0

# Enable debug overlays: FPS counter, hitbox visualization,
# pathfinding route display, object pool stats.
# Set to "true" during development, "false" for production.
VITE_DEBUG=false

# Base URL for Phaser asset loading. Override this to point at a
# CDN in production. In development, assets are served from the
# Vite dev server at /assets.
VITE_ASSET_BASE_URL=/assets

# Optional fixed seed for reproducible game runs.
# Leave empty to auto-generate a random seed each run.
VITE_GAME_SEED=
